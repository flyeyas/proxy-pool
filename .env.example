# ProxyPool 环境变量配置模板
# 使用方法: 复制本文件为 .env 并按需修改; .env / .env.local 均不入库(.gitignore 已排除)
# 优先级: 系统环境变量 > .env.local(本地开发覆盖) > .env(线上默认) > setting.py 默认值
# 线上服务器只放 .env; 本地测试想覆盖个别配置时, 复制一份为 .env.local 写在里面
# 注意: 删除某行即回退到 setting.py 的默认值

# ---------- 数据库连接(常用) ----------
# Redis: redis://:password@ip:port/db    SSDB: ssdb://:password@ip:port
DB_CONN=redis://:password@127.0.0.1:6379/0

# ---------- API 服务 ----------
# HOST=0.0.0.0
# PORT=5010

# ---------- 代理表名 ----------
# TABLE_NAME=use_proxy

# ---------- 代理验证 ----------
# HTTP_URL=http://httpbin.org
# HTTPS_URL=https://www.qq.com
# VERIFY_TIMEOUT=10
# MAX_FAIL_COUNT=0
# POOL_SIZE_MIN=20

# ---------- 其他 ----------
# PROXY_REGION=True
# TIMEZONE=Asia/Shanghai

# ---------- WebUI 登录(设置密码后启用登录验证) ----------
# WEBUI_USERNAME=admin
# WEBUI_PASSWORD=
# WEBUI_SECRET_KEY=            # 可选: 会话签名密钥, 不设则由账号密码自动派生
